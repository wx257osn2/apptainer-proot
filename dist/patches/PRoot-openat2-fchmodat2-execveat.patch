+/**
+ * Copy in @how the open_how structure of @size bytes pointed to by the
+ * @reg argument of the current syscall, and check it as the kernel
+ * does.  This function returns -errno if an error occured, otherwise
+ * 0.
+ */
+static int get_sysarg_open_how(const Tracee *tracee, OpenHow *how, Reg reg, word_t size)
+{
+	unsigned char chunk[256];
+	word_t address;
+	word_t offset;
+	word_t length;
+	word_t i;
+	int status;
