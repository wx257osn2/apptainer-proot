+/**
+ * Put in @path the guest path of the program referred to by the
+ * @tracee's descriptor @fd.  This function returns -ENOSYS if there's
+ * no such path, as for a memfd, otherwise -errno if an error occured,
+ * or 0.
+ */
+static int get_exec_fd_path(Tracee *tracee, int fd, char path[PATH_MAX])
+{
+	char host_path[PATH_MAX];
+	char fd_path[64]; /* 64 > sizeof("/proc//fd/") + 2 * sizeof(#ULONG_MAX) */
+	struct stat fd_statl;
+	struct stat statl;
+	int status;
+
+	status = snprintf(fd_path, sizeof(fd_path), "/proc/%d/fd/%d", tracee->pid, fd);
+	if (status < 0 || (size_t) status >= sizeof(fd_path))
+		return -EBADF;
+
+	if (stat(fd_path, &fd_statl) < 0)
+		return -EBADF;
+
+	/* The program is loaded by PRoot from its path, fexecve(3)
+	 * falls back to "/proc/self/fd/" on ENOSYS.  */
+	status = get_fd_path(tracee, fd, path);
+	if (status < 0)
+		return -ENOSYS;
+
+	status = translate_path(tracee, host_path, AT_FDCWD, path, true);
+	if (   status < 0
+	    || stat(host_path, &statl) < 0
+	    || statl.st_dev != fd_statl.st_dev
+	    || statl.st_ino != fd_statl.st_ino)
+		return -ENOSYS;
+
+	return 0;
+}
+
+/**
+ * Turn the current execveat(2) of @tracee into execve(2), then
+ * translate it with translate_execve_enter().  This function returns
+ * -errno if an error occured, otherwise 0.
+ */
+int translate_execveat_enter(Tracee *tracee)
+{
+	char user_path[PATH_MAX];
+	char host_path[PATH_MAX];
+	char base[PATH_MAX];
+	char path[PATH_MAX];
+	struct stat statl;
+	int dirfd;
+	int flags;
+	int status;
+
+	dirfd = peek_reg(tracee, CURRENT, SYSARG_1);
+	flags = peek_reg(tracee, CURRENT, SYSARG_5);
+
+	/* Other flags, like AT_EXECVE_CHECK, must not execute the
+	 * program.  */
+	if ((flags & ~(AT_EMPTY_PATH | AT_SYMLINK_NOFOLLOW)) != 0)
+		return -EINVAL;
+
+	status = get_sysarg_path(tracee, user_path, SYSARG_2);
+	if (status < 0)
+		return status;
+
+	if (user_path[0] == '\0') {
+		if ((flags & AT_EMPTY_PATH) == 0)
+			return -ENOENT;
+
+		status = get_exec_fd_path(tracee, dirfd, path);
+		if (status < 0)
+			return status;
+	}
+	else if (user_path[0] != '/' && dirfd != AT_FDCWD) {
+		status = get_fd_path(tracee, dirfd, base);
+		if (status < 0)
+			return status;
+
+		status = join_paths(2, path, base, user_path);
+		if (status < 0)
+			return status;
+	}
+	else
+		strcpy(path, user_path);
+
+	if ((flags & AT_SYMLINK_NOFOLLOW) != 0 && user_path[0] != '\0') {
+		status = translate_path(tracee, host_path, AT_FDCWD, path, false);
+		if (status < 0)
+			return status;
+
+		if (lstat(host_path, &statl) == 0 && S_ISLNK(statl.st_mode))
+			return -ELOOP;
+	}
+
+	status = set_sysarg_path(tracee, path, SYSARG_1);
+	if (status < 0)
+		return status;
+
+	poke_reg(tracee, SYSARG_2, peek_reg(tracee, CURRENT, SYSARG_3));
+	poke_reg(tracee, SYSARG_3, peek_reg(tracee, CURRENT, SYSARG_4));
+	set_sysnum(tracee, PR_execve);
+
+	return translate_execve_enter(tracee);
+}
