+	/* Fields unknown to PRoot can't be translated, a kernel which
+	 * doesn't know them accepts them only if they are unused.  */
+	for (offset = sizeof(OpenHow); offset < size; offset += length) {
+		length = size - offset < sizeof(chunk) ? size - offset : sizeof(chunk);
