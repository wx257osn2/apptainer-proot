+#define RESOLVE_ALL (RESOLVE_NO_XDEV | RESOLVE_NO_MAGICLINKS | RESOLVE_NO_SYMLINKS \
+		| RESOLVE_BENEATH | RESOLVE_IN_ROOT | RESOLVE_CACHED)
